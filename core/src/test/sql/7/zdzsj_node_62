SELECT DW_ID, DW_CODE, DW_NAME, REPORT_ITEM_NAME, PARENT_ID, SUM(JE1) JE1, REPORT_ITEM_ID, REMARK, TYPE,MOF_DIV_CODE,COMPUTE_TYPE        FROM (                 SELECT B.DW_ID,Y.AGENCY_CODE AS DW_CODE, Y.AGENCY_NAME DW_NAME,                        B.REPORT_ITEM_NAME,                        (CASE WHEN Y.LEVEL_NO=1 THEN Y.AGENCY_ID ELSE Y.PARENT_ID END ) AS PARENT_ID,                        (B.JE1 * B.DIR * t3.DIR) JE1 ,B.REPORT_ITEM_ID, T2.REMARK, '-3' TYPE,B.MOF_DIV_CODE,H2.COMPUTE_TYPE                 FROM GFR_VCHDETAIL_BM B,                      GFR_VCH_BM T2,                      GFR_V_AGENCY_2025 Y,                      GFR_REPORT_CLS T3,                      GFR_VCHDETAIL H1,                      GFR_FIXED_TEMPCONFIG H2                 WHERE B.DW_ID = Y.AGENCY_ID                   AND B.VCH_BM_ID = T2.VCH_BM_ID                   AND B.SET_YEAR = $1                   AND T2.SET_YEAR = $2                   AND B.REPORT_ITEM_CODE = T3.REPORT_ITEM_CODE                   AND T3.SET_YEAR = $3                   AND NVL(B.JE1,0) != 0                   AND H1.VCHDETAIL_ID=B.VCHDETAIL_BM_ID                   AND H1.REPORT_ITEM_CODE LIKE H2.REPORT_ITEM_CODE||'%'                   AND H2.C_CODE = $4                   AND H2.QUERY_TYPE = 1                   AND H2.C_TYPE = $5                   AND H1.TYPE = -3                   AND H1.IS_LEAF = 1                   AND H1.RULE_ID = $6                   AND H1.SET_YEAR = $7                   AND H2.SET_YEAR = $8                   AND EXISTS (SELECT 1 FROM (SELECT U.S_DW_CODE FROM GFR_UPLINKSOURCE U,GFR_REPORTUP P WHERE U.C_DW_CODE = P.DW_ID AND U.SET_YEAR = P.SET_YEAR                   AND P.BBREP_STATUS = '2' AND U.P_DW_CODE = $9 AND U.SET_YEAR = $10                     UNION ALL SELECT $11 AS S_DW_CODE FROM DUAL) P WHERE P.S_DW_CODE = H1.DW_ID)                 UNION ALL                 SELECT                     T1.DW_ID,T1.DW_CODE,T5.MOF_DIV_NAME DW_NAME,                     T1.REPORT_ITEM_NAME,                     T5.PARENT_ID,                     (T1.JE1 * T1.DIR * T3.DIR) JE1,T1.REPORT_ITEM_ID, T2.REMARK, '-1' TYPE,T1.MOF_DIV_CODE,T4.COMPUTE_TYPE                 FROM GFR_VCHDETAIL T1, GFR_VCH T2, GFR_REPORT_CLS T3, GFR_FIXED_TEMPCONFIG T4,GFR_V_PROVINCE T5                 WHERE T1.VCH_ID = T2.VCH_ID                   AND T1.DW_ID = T5.MOF_DIV_ID                   AND T1.REPORT_ITEM_CODE = T3.REPORT_ITEM_CODE                   AND T1.REPORT_ITEM_CODE LIKE T4.REPORT_ITEM_CODE||'%'                   AND T4.C_CODE = $12                   AND T4.QUERY_TYPE = 1                   AND T4.C_TYPE = $13                   AND T1.TYPE = -1                   AND T1.IS_LEAF = 1                   AND T1.RULE_ID = $14                   AND T1.SET_YEAR = $15                   AND T2.SET_YEAR = $16                   AND T3.SET_YEAR = $17                   AND T4.SET_YEAR = $18                   AND T5.START_YEAR <= $19 AND T5.END_YEAR > $20                   AND EXISTS (SELECT 1 FROM (SELECT U.S_DW_CODE FROM GFR_UPLINKSOURCE U,GFR_REPORTUP P WHERE U.C_DW_CODE = P.DW_ID AND U.SET_YEAR = P.SET_YEAR                   AND P.BBREP_STATUS = '2' AND U.P_DW_CODE = $21 AND U.SET_YEAR = $22                     UNION ALL SELECT $23 AS S_DW_CODE FROM DUAL) P WHERE P.S_DW_CODE = T1.DW_ID)             ) group by DW_ID, DW_CODE, DW_NAME, REPORT_ITEM_NAME, PARENT_ID,REPORT_ITEM_ID, REMARK, TYPE,MOF_DIV_CODE,COMPUTE_TYPE

SELECT     zba.CHS_ACCEPT_ID AS 受理号,    zhi.MEDICAL_INSTITUTION_NAME AS 医疗机构名称,    zhi.MEDICAL_INSTITUTION_CODE AS 医疗机构编码,    zhi.START_DATE AS 就诊开始时间,    zhi.END_DATE AS 就诊结束时间,    zd.NAME AS 医疗类别,    zrr.NAME AS 识别名称,    zrr.THREE_CATALOGUES_NAME AS 映射项目名称,    zrr.THREE_CATALOGUES_CODE AS 映射项目编码FROM     znlb_recognition_result zrrLEFT JOIN znlb_hospitalized_information zhi     ON zhi.id = zrr.HOSPITALIZED_INFORMATION_IDLEFT JOIN znlb_dictionary zd     ON zd.TYPE_CODE = 'MED_TYPE'    AND zd.CODE = zhi.MEDICAL_CATEGORYLEFT JOIN znlb_business_accept zba     ON zba.id = zrr.BUSINESS_ACCEPT_IDWHERE     zba.MEDICAL_INSURANCE_AREA_CODE = '339900'    AND (        zhi.MEDICAL_INSTITUTION_AREA_CODE LIKE '310%'         OR zhi.MEDICAL_INSTITUTION_AREA_CODE LIKE '110%'    )    AND zhi.SETTLE_STATUS = 1    AND zrr.DELETE_FLAG = 0 limit 0, 200
